# Copy to .env locally. Never commit real credentials.
POSTGRES_DB=hero_vired
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@db:5432/hero_vired
SIMULATOR_STATE_PATH=/tmp/hero-vired-simulator-state.json

MODEL_GATEWAY_TOKEN=
MODEL_GATEWAY_URL=https://api.openai.com/v1/responses
MODEL_GATEWAY_FORMAT=openai_responses
MODEL_GATEWAY_MODEL=gpt-4o-mini
MODEL_GATEWAY_TIMEOUT_SECONDS=5
MODEL_MAX_EVIDENCE_ITEMS=100
MODEL_MAX_PROMPT_BYTES=32000
INVESTIGATION_CONCURRENCY=4
INVESTIGATION_QUEUE_TIMEOUT_SECONDS=1
EVIDENCE_CONCURRENCY=4
EVIDENCE_TIMEOUT_SECONDS=2
EXTERNAL_BOUNDARY_TIMEOUT_SECONDS=5
JOB_RETRY_BACKOFF_SECONDS=2
NOTIFICATION_GATEWAY_URL=
NOTIFICATION_GATEWAY_TOKEN=
NOTIFICATION_SMTP_HOST=mailpit
NOTIFICATION_SMTP_PORT=1025
NOTIFICATION_EMAIL_FROM=assistant@demo.local
NOTIFICATION_EMAIL_TO=oncall@demo.local
OWNERSHIP_GATEWAY_URL=
OWNERSHIP_GATEWAY_TOKEN=
ACTION_EXECUTOR_URL=
ACTION_EXECUTOR_TOKEN=
