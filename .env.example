# Copy to .env locally. Never commit real credentials.
POSTGRES_DB=hero_vired
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@db:5432/hero_vired
SIMULATOR_STATE_PATH=/tmp/hero-vired-simulator-state.json

MODEL_GATEWAY_TOKEN=
MODEL_GATEWAY_URL=https://api.openai.com/v1/responses
MODEL_GATEWAY_FORMAT=openai_responses
MODEL_GATEWAY_MODEL=gpt-4o-mini
NOTIFICATION_GATEWAY_URL=
NOTIFICATION_GATEWAY_TOKEN=
OWNERSHIP_GATEWAY_URL=
OWNERSHIP_GATEWAY_TOKEN=
ACTION_EXECUTOR_URL=
ACTION_EXECUTOR_TOKEN=
